#version 450
// (hookshot) NVIDIA DLSS's picture into OoT's gameplay upscale's output (vk_dlss.cpp): what the network's own output
// does, the square of its perceptual encoding (linear colour again). DLAA's picture is at the render size: scaled up to the
// output's with the sampler's linear filter.
// A colour grade on the way (dlss_grade.h, the same arithmetic; RX_DLSS_GRADE_SAT, _DENSITY and _CONTRAST), on the encoded
// colour: all three 0, the colour is written as it came.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, r11f_g11f_b10f) uniform writeonly image2D dst;
layout(push_constant) uniform P { ivec2 size; float sat; float contrast; float density; } pc;
vec3 grade(vec3 c) {
    c = min(c, vec3(65504.0));
    const float top = max(c.r, max(c.g, c.b));
    c = max(top - (top - c) * (1.0 + pc.sat), vec3(0.0));
    const float low = min(c.r, min(c.g, c.b));
    const float dark = 1.0 - pc.density * (top > 0.0 ? (top - low) / top : 0.0);
    c = (c * dark - 0.435) * (1.0 + pc.contrast) + 0.435;
    return max(c, vec3(0.0));
}
void main() {
    const ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(g, pc.size))) return;
    vec3 c = all(equal(textureSize(src, 0), pc.size)) ? texelFetch(src, g, 0).rgb
                                                     : textureLod(src, (vec2(g) + 0.5) / vec2(pc.size), 0.0).rgb;
    c = max(c, vec3(0.0));
    c = pc.sat != 0.0 || pc.contrast != 0.0 || pc.density != 0.0 ? grade(c) : c;
    c *= c;
    imageStore(dst, g, vec4(c, 1.0));
}
