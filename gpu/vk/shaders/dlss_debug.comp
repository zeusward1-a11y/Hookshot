#version 450
// (hookshot) RX_DLSS_DEBUG=1..4: DLSS's inputs drawn into the network's target in place of DLSS's output (vk_draw.cpp).
// 1: motion, 0.5 grey = still, R/G = 0.5 + x/y render pixels / 64 (toward the previous frame); 2: depth^64;
// 3: |last frame's colour fetched along the motion - this frame's colour| x4; 4: the same without the motion (the baseline)

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D cur_color;
layout(binding = 1) uniform sampler2D motion;
layout(binding = 2) uniform sampler2D scene_depth;
layout(binding = 3) uniform sampler2D prev_color;
layout(binding = 4, r11f_g11f_b10f) uniform writeonly image2D target;
layout(push_constant) uniform P { int mode; } pc;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(target);
    if (any(greaterThanEqual(pixel, extent))) {
        return;
    }
    vec2 uv = (vec2(pixel) + 0.5) / vec2(extent);
    vec2 mv = textureLod(motion, uv, 0).xy;
    vec3 c;
    if (pc.mode == 1) {
        c = vec3(clamp(0.5 + mv / 64.0, 0.0, 1.0), 0.5);
    } else if (pc.mode == 2) {
        c = vec3(pow(textureLod(scene_depth, uv, 0).r, 64.0));
    } else {
        vec2 from = uv + (pc.mode == 3 ? mv / vec2(textureSize(cur_color, 0)) : vec2(0));
        vec3 d = abs(textureLod(prev_color, from, 0).rgb - textureLod(cur_color, uv, 0).rgb);
        c = vec3(min((d.r + d.g + d.b) * (4.0 / 3.0), 1.0));
    }
    imageStore(target, pixel, vec4(c, 1.0));
}